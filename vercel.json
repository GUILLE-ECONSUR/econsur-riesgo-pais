{
  "functions": {
    "api/embi.js": {
      "includeFiles": "data/**",
      "maxDuration": 30
    },
    "api/macro.js": {
      "includeFiles": "data/**",
      "maxDuration": 30
    },
    "api/ratings.js": {
      "includeFiles": "data/**",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
